.hud { position: absolute; width: 100%; height: 100%; color: rgb(250, 246, 232); justify-content: center; align-items: center; }
.stats { position: absolute; left: 0; right: 0; top: 0; height: 64px; padding: 0 28px; flex-direction: row; align-items: center; background-color: rgba(28, 36, 30, 0.72); border-bottom-width: 2px; border-color: rgb(120, 150, 96); }
.stat { font-size: 26px; -unity-font-style: bold; margin-right: 44px; -unity-text-outline-width: 1px; -unity-text-outline-color: rgb(20, 24, 20); }
.level { color: rgb(255, 226, 140); }
.pause { position: absolute; right: 20px; top: 9px; height: 46px; width: 200px; margin: 0; font-size: 20px; }
.panel { width: 640px; padding: 32px 40px; background-color: rgba(30, 40, 34, 0.93); border-radius: 18px; border-width: 2px; border-color: rgb(132, 164, 104); }
.headline { font-size: 54px; -unity-font-style: bold; color: rgb(255, 222, 128); -unity-text-align: middle-center; white-space: normal; }
.message { margin-top: 16px; margin-bottom: 16px; font-size: 24px; white-space: normal; -unity-text-align: middle-center; }
.buttons { align-items: stretch; }
Button { height: 54px; margin: 8px 0 0 0; font-size: 23px; color: rgb(250, 246, 232); background-color: rgb(64, 96, 58); border-color: rgb(140, 176, 110); border-width: 1px; border-radius: 10px; }
Button:hover { background-color: rgb(78, 114, 70); }
Button:active { background-color: rgb(94, 132, 84); }
