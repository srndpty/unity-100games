.hud { position: absolute; width: 100%; height: 100%; color: rgb(226, 232, 222); justify-content: center; align-items: center; }
.stats { position: absolute; left: 0; right: 0; top: 0; height: 64px; padding: 0 28px; flex-direction: row; align-items: center; background-color: rgba(10, 14, 12, 0.92); border-bottom-width: 2px; border-color: rgb(90, 120, 80); }
.stat { font-size: 24px; -unity-font-style: bold; margin-right: 34px; -unity-text-outline-width: 1px; -unity-text-outline-color: rgb(6, 8, 6); }
.floor { color: rgb(255, 214, 120); min-width: 110px; }
.level { color: rgb(200, 230, 255); min-width: 120px; }
.turns { color: rgba(226, 232, 222, 0.8); font-size: 20px; }
.bar { height: 30px; margin-right: 30px; border-width: 2px; border-radius: 6px; overflow: hidden; justify-content: center; }
.hp-bar { width: 300px; background-color: rgb(40, 14, 14); border-color: rgb(150, 60, 50); }
.food-bar { width: 240px; background-color: rgb(36, 28, 12); border-color: rgb(150, 120, 50); }
.bar-fill { position: absolute; left: 0; top: 0; bottom: 0; width: 100%; }
.hp-fill { background-color: rgb(190, 40, 40); }
.food-fill { background-color: rgb(190, 140, 40); }
.bar-text { -unity-text-align: middle-center; font-size: 19px; -unity-font-style: bold; -unity-text-outline-width: 1px; -unity-text-outline-color: rgb(12, 6, 4); }
.log { position: absolute; left: 0; right: 0; bottom: 0; height: 200px; padding: 6px 28px; background-color: rgba(10, 14, 12, 0.92); border-top-width: 2px; border-color: rgb(90, 120, 80); }
.hint { font-size: 17px; color: rgba(226, 232, 222, 0.7); margin-bottom: 4px; }
.lines { flex-grow: 1; }
.line { font-size: 22px; height: 26px; margin: 0; padding: 0; }
.line-old { color: rgba(226, 232, 222, 0.55); }
.panel { width: 980px; padding: 30px 40px; background-color: rgba(10, 16, 14, 0.96); border-radius: 18px; border-width: 2px; border-color: rgb(110, 150, 90); }
.headline { font-size: 60px; -unity-font-style: bold; color: rgb(255, 214, 120); -unity-text-align: middle-center; white-space: normal; }
.message { margin-top: 14px; margin-bottom: 14px; font-size: 21px; white-space: normal; -unity-text-align: middle-left; }
.buttons { align-items: stretch; }
Button { height: 48px; margin: 6px 0 0 0; font-size: 20px; color: rgb(230, 236, 226); background-color: rgb(34, 60, 44); border-color: rgb(110, 150, 90); border-width: 1px; border-radius: 8px; }
Button:hover { background-color: rgb(46, 80, 58); }
Button:active { background-color: rgb(60, 100, 72); }
.inventory { position: absolute; left: 160px; right: 160px; top: 100px; bottom: 230px; padding: 20px; flex-direction: row; background-color: rgba(10, 16, 14, 0.97); border-radius: 14px; border-width: 2px; border-color: rgb(110, 150, 90); }
.inv-column { padding: 0 16px; }
.inv-list { width: 46%; }
.inv-detail { width: 54%; }
.inv-title { font-size: 24px; -unity-font-style: bold; color: rgb(255, 214, 120); margin: 0 0 8px 0; }
.bag { flex-direction: row; flex-wrap: wrap; }
.cell { width: 48%; height: 44px; margin: 3px 1% 0 1%; padding-left: 8px; flex-direction: row; align-items: center; border-width: 1px; border-radius: 6px; border-color: rgba(110, 150, 90, 0.4); }
.cell-icon { width: 32px; height: 32px; margin-right: 8px; flex-shrink: 0; -unity-background-scale-mode: scale-to-fit; }
.cell-text { font-size: 19px; margin: 0; padding: 0; -unity-text-align: middle-left; }
.selected { border-width: 3px; border-color: rgb(255, 230, 140); background-color: rgb(52, 80, 56); }
.empty { color: rgba(226, 232, 222, 0.3); }
.detail-head { flex-direction: row; align-items: center; margin-bottom: 10px; }
.detail-icon { width: 64px; height: 64px; margin-right: 14px; flex-shrink: 0; -unity-background-scale-mode: scale-to-fit; }
.detail-name { font-size: 28px; -unity-font-style: bold; white-space: normal; flex-shrink: 1; color: rgb(255, 230, 170); }
.detail { font-size: 21px; white-space: normal; margin-bottom: 18px; }
.inv-keys { font-size: 18px; white-space: normal; color: rgba(226, 232, 222, 0.8); }
.inv-facing { font-size: 18px; margin-top: 8px; color: rgb(170, 220, 255); }
.map-layer { position: absolute; left: 0; right: 0; top: 64px; bottom: 200px; justify-content: center; align-items: center; background-color: rgba(0, 0, 0, 0.45); }
.minimap { width: 1344px; height: 756px; -unity-background-scale-mode: stretch-to-fill; }
