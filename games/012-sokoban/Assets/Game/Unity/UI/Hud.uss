.hud { position: absolute; width: 100%; height: 100%; color: rgb(226, 236, 240); }
.panel { position: absolute; left: 58%; right: 3%; top: 6%; bottom: 6%; padding: 32px; background-color: rgb(18, 34, 44); border-radius: 18px; border-width: 1px; border-color: rgb(64, 118, 138); }
.headline { font-size: 58px; -unity-font-style: bold; color: rgb(250, 196, 84); }
.level-name { font-size: 30px; margin-top: 4px; color: rgb(170, 214, 226); }
.stats { flex-direction: row; justify-content: space-between; margin-top: 14px; margin-bottom: 14px; padding-top: 12px; padding-bottom: 12px; border-top-width: 1px; border-bottom-width: 1px; border-color: rgb(64, 118, 138); }
.stat { font-size: 28px; -unity-font-style: bold; color: rgb(236, 244, 246); }
.message { flex-grow: 1; font-size: 26px; white-space: normal; }
.levels { flex-direction: row; flex-wrap: wrap; justify-content: space-between; margin-bottom: 8px; }
.buttons { align-items: stretch; }
Button { height: 58px; margin: 8px 0 0 0; font-size: 26px; color: rgb(240, 248, 250); background-color: rgb(32, 92, 112); border-color: rgb(84, 156, 178); border-width: 1px; border-radius: 8px; }
Button:hover { background-color: rgb(40, 112, 136); }
Button:active { background-color: rgb(50, 132, 158); }
.level { width: 18.5%; height: 72px; margin: 6px 0 0 0; font-size: 26px; -unity-font-style: bold; }
.level--cleared { background-color: rgb(34, 104, 78); border-color: rgb(96, 186, 146); }
.level--selected { border-width: 4px; border-color: rgb(250, 196, 84); }
