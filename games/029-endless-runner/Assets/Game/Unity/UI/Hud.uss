.hud { position: absolute; width: 100%; height: 100%; color: rgb(255, 236, 214); justify-content: center; align-items: center; }
.stats { position: absolute; left: 0; right: 0; top: 0; height: 56px; padding: 0 24px; flex-direction: row; align-items: center; background-color: rgba(26, 10, 6, 0.7); border-bottom-width: 2px; border-color: rgb(220, 110, 50); }
.stat { font-size: 26px; -unity-font-style: bold; margin-right: 40px; -unity-text-outline-width: 1px; -unity-text-outline-color: rgb(14, 6, 4); }
.distance { color: rgb(255, 214, 120); min-width: 180px; font-size: 30px; }
.speed { color: rgb(255, 150, 90); min-width: 180px; }
.best { color: rgb(220, 200, 255); font-size: 22px; }
.pause { position: absolute; right: 20px; top: 6px; height: 44px; width: 190px; margin: 0; font-size: 20px; }
.panel { width: 1040px; padding: 30px 40px; background-color: rgba(30, 12, 8, 0.93); border-radius: 18px; border-width: 2px; border-color: rgb(230, 120, 60); }
.headline { font-size: 58px; -unity-font-style: bold; color: rgb(255, 170, 90); -unity-text-align: middle-center; white-space: normal; }
.message { margin-top: 14px; margin-bottom: 14px; font-size: 22px; white-space: normal; -unity-text-align: middle-center; }
.buttons { align-items: stretch; }
Button { height: 52px; margin: 8px 0 0 0; font-size: 22px; color: rgb(255, 236, 214); background-color: rgb(96, 40, 24); border-color: rgb(230, 120, 60); border-width: 1px; border-radius: 10px; }
Button:hover { background-color: rgb(122, 52, 30); }
Button:active { background-color: rgb(150, 66, 38); }
