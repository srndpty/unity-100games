<ui:UXML xmlns:ui="UnityEngine.UIElements">
    <Style src="Hud.uss" />
    <ui:VisualElement name="hud" class="hud" picking-mode="Ignore">
        <ui:VisualElement name="top" class="top" picking-mode="Ignore">
            <ui:Label name="brand" text="CINDER LEDGER" class="brand" picking-mode="Ignore" />
            <ui:Label name="route" text=" " class="route" picking-mode="Ignore" />
            <ui:Label name="hp" text=" " class="top-stat top-hp" picking-mode="Ignore" />
            <ui:Label name="deck" text=" " class="top-stat" picking-mode="Ignore" />
        </ui:VisualElement>
        <ui:VisualElement name="seats" class="layer" picking-mode="Ignore" />
        <ui:VisualElement name="battle" class="layer" picking-mode="Ignore">
            <ui:VisualElement name="energy" class="energy" picking-mode="Ignore">
                <ui:Label name="energy-text" text=" " class="energy-text" picking-mode="Ignore" />
            </ui:VisualElement>
            <ui:Label name="draw-pile" text=" " class="pile pile-draw" picking-mode="Ignore" />
            <ui:Label name="discard-pile" text=" " class="pile pile-discard" picking-mode="Ignore" />
            <ui:Label name="exhaust-pile" text=" " class="pile pile-exhaust" picking-mode="Ignore" />
            <ui:VisualElement name="end-turn" class="btn end-turn">
                <ui:Label text="ターン終了 / E" class="btn-text" picking-mode="Ignore" />
            </ui:VisualElement>
            <ui:VisualElement name="hand" class="hand" picking-mode="Ignore" />
            <ui:VisualElement name="resolving" class="resolving" picking-mode="Ignore" />
            <ui:Label name="banner" text=" " class="banner" picking-mode="Ignore" />
            <ui:Label name="hint" text="カードをクリック → 敵をクリック　1〜0 カード　←→/Tab 対象　Enter 決定　E ターン終了　右クリック/Esc 取り消し・一時停止" class="hint" picking-mode="Ignore" />
        </ui:VisualElement>
        <ui:VisualElement name="arrow-layer" class="layer" picking-mode="Ignore" />
        <ui:Label name="notice" text=" " class="notice" picking-mode="Ignore" />
        <ui:VisualElement name="panel-layer" class="panel-layer" picking-mode="Ignore">
            <ui:VisualElement name="panel" class="panel" />
        </ui:VisualElement>
    </ui:VisualElement>
</ui:UXML>
