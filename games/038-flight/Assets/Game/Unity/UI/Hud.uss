.hud { position: absolute; width: 100%; height: 100%; color: rgb(170, 255, 190); justify-content: center; align-items: center; }
.layer { position: absolute; left: 0; top: 0; right: 0; bottom: 0; }
.hit-flash { position: absolute; left: 0; top: 0; right: 0; bottom: 0; background-color: rgba(255, 40, 30, 0.35); display: none; }
.stats { position: absolute; top: 24px; padding: 12px 20px; background-color: rgba(6, 20, 14, 0.55); border-radius: 8px; border-width: 1px; border-color: rgba(120, 255, 160, 0.6); }
.stats-left { left: 24px; }
.stats-right { right: 24px; align-items: flex-end; }
.stat { font-size: 30px; -unity-font-style: bold; margin: 0; padding: 0; -unity-text-outline-width: 1px; -unity-text-outline-color: rgb(0, 20, 8); }
.stat-small { font-size: 22px; -unity-font-style: normal; }
.warning { position: absolute; top: 210px; left: 0; right: 0; font-size: 46px; -unity-font-style: bold; -unity-text-align: middle-center; color: rgb(255, 90, 70); -unity-text-outline-width: 2px; -unity-text-outline-color: rgb(40, 0, 0); }
.kill { position: absolute; top: 280px; left: 0; right: 0; font-size: 40px; -unity-font-style: bold; -unity-text-align: middle-center; color: rgb(255, 230, 120); -unity-text-outline-width: 2px; -unity-text-outline-color: rgb(40, 20, 0); }
.lock-state { position: absolute; bottom: 200px; left: 0; right: 0; font-size: 34px; -unity-font-style: bold; -unity-text-align: middle-center; -unity-text-outline-width: 1px; -unity-text-outline-color: rgb(0, 20, 8); }
.lock-locking { color: rgb(255, 230, 90); }
.lock-locked { color: rgb(255, 80, 60); }
.lock-rejected { color: rgb(200, 200, 200); }
.boresight { position: absolute; width: 36px; height: 36px; margin-left: -18px; margin-top: -18px; }
.bore-h { position: absolute; left: 0; top: 17px; width: 36px; height: 2px; background-color: rgb(170, 255, 190); }
.bore-v { position: absolute; left: 17px; top: 0; width: 2px; height: 36px; background-color: rgb(170, 255, 190); }
.fpm { position: absolute; width: 64px; height: 24px; margin-left: -32px; margin-top: -12px; }
.fpm-ring { position: absolute; left: 22px; top: 2px; width: 20px; height: 20px; border-radius: 10px; border-width: 2px; border-color: rgb(120, 220, 255); }
.fpm-wing { position: absolute; top: 11px; width: 18px; height: 2px; background-color: rgb(120, 220, 255); }
.fpm-left { left: 2px; }
.fpm-right { right: 2px; }
.target { position: absolute; width: 56px; height: 56px; margin-left: -28px; margin-top: -28px; border-width: 2px; border-color: rgb(120, 255, 150); display: none; }
.target-locking { border-color: rgb(255, 230, 90); border-width: 3px; }
.target-locked { border-color: rgb(255, 70, 50); border-width: 4px; }
.target-label { position: absolute; top: 58px; left: -40px; width: 136px; font-size: 22px; -unity-font-style: bold; color: rgb(190, 255, 205); -unity-text-align: upper-center; margin: 0; padding: 0; -unity-text-outline-width: 1px; -unity-text-outline-color: rgb(0, 20, 8); }
.radar { position: absolute; right: 28px; bottom: 28px; width: 240px; height: 240px; border-radius: 120px; background-color: rgba(6, 20, 14, 0.55); border-width: 1px; border-color: rgba(120, 255, 160, 0.6); overflow: hidden; }
.radar-ring { position: absolute; left: 60px; top: 60px; width: 120px; height: 120px; border-radius: 60px; border-width: 1px; border-color: rgba(120, 255, 160, 0.35); }
.radar-dot { position: absolute; width: 12px; height: 12px; margin-left: -6px; margin-top: -6px; border-radius: 6px; }
.radar-self { background-color: rgb(120, 220, 255); left: 120px; top: 120px; }
.radar-enemy { background-color: rgb(255, 90, 70); }
.radar-runway { position: absolute; width: 6px; height: 18px; margin-left: -3px; margin-top: -9px; background-color: rgb(200, 200, 200); }
.panel { position: absolute; padding: 30px 48px; background-color: rgba(8, 20, 30, 0.9); border-radius: 16px; border-width: 2px; border-color: rgb(120, 220, 255); align-items: center; color: rgb(220, 240, 255); }
.title-panel { width: 1080px; }
.small-panel { width: 900px; }
.headline { font-size: 64px; -unity-font-style: bold; color: rgb(150, 230, 255); -unity-text-align: middle-center; }
.subline { font-size: 26px; margin-top: 6px; margin-bottom: 18px; -unity-text-align: middle-center; white-space: normal; }
.controls { align-items: flex-start; margin-bottom: 12px; }
.control { font-size: 24px; margin: 2px 0; }
.hint { font-size: 20px; margin-top: 12px; color: rgb(255, 220, 150); white-space: normal; }
.prompt { font-size: 28px; margin-top: 12px; color: rgb(255, 230, 150); -unity-font-style: bold; }
