.hud { position: absolute; width: 100%; height: 100%; color: rgb(239, 241, 211); }
.brand { position: absolute; top: 12%; left: 3%; width: 280px; }
.eyebrow { font-size: 16px; letter-spacing: 2px; color: rgb(178, 208, 155); }
.brand-title { font-size: 38px; -unity-font-style: bold; margin-top: 10px; }
.tagline { font-size: 19px; margin-top: 10px; color: rgb(182, 196, 170); }
.guide { position: absolute; right: 3%; top: 30%; width: 210px; }
.progress { font-size: 26px; -unity-font-style: bold; color: rgb(247, 212, 137); }
.hint { font-size: 21px; white-space: normal; margin-top: 24px; color: rgb(200, 213, 182); }
.overlay { position: absolute; width: 100%; height: 100%; align-items: center; justify-content: center; background-color: rgba(10, 27, 21, 0.65); }
.card { width: 580px; padding: 30px; align-items: center; background-color: rgb(25, 52, 40); border-radius: 20px; border-width: 1px; border-color: rgb(112, 145, 93); }
.headline { font-size: 56px; -unity-font-style: bold; color: rgb(248, 219, 151); margin-top: 8px; }
.message { font-size: 22px; white-space: normal; -unity-text-align: middle-center; margin-top: 15px; margin-bottom: 14px; }
Button { width: 280px; height: 48px; margin-top: 10px; font-size: 21px; color: rgb(245, 241, 213); background-color: rgb(63, 103, 63); border-color: rgb(129, 159, 98); border-width: 1px; border-radius: 8px; }
Button:hover { background-color: rgb(87, 131, 75); }
Button:active { background-color: rgb(111, 150, 83); }
