.hud { position: absolute; width: 100%; height: 100%; color: rgb(240, 236, 214); }
.panel { position: absolute; left: 58%; right: 3%; top: 7%; bottom: 7%; padding: 36px; background-color: rgb(38, 48, 36); border-radius: 18px; border-width: 1px; border-color: rgb(112, 132, 92); }
.headline { font-size: 64px; -unity-font-style: bold; color: rgb(244, 220, 136); }
.stats { flex-direction: row; justify-content: space-between; margin-top: 18px; margin-bottom: 18px; padding-top: 14px; padding-bottom: 14px; border-top-width: 1px; border-bottom-width: 1px; border-color: rgb(112, 132, 92); }
.stat { font-size: 32px; -unity-font-style: bold; color: rgb(232, 240, 200); }
.message { flex-grow: 1; font-size: 28px; white-space: normal; }
.buttons { align-items: stretch; }
Button { height: 62px; margin: 8px 0 0 0; font-size: 27px; color: rgb(246, 242, 220); background-color: rgb(84, 112, 62); border-color: rgb(136, 164, 100); border-width: 1px; border-radius: 8px; }
Button:hover { background-color: rgb(102, 134, 74); }
Button:active { background-color: rgb(120, 152, 86); }
