.hud { position: absolute; width: 100%; height: 100%; color: rgb(238, 236, 228); }
.stats { position: absolute; left: 61%; right: 3%; top: 6%; bottom: 4%; }
.brand { font-size: 44px; -unity-font-style: bold; color: rgb(250, 206, 120); letter-spacing: 5px; }
.stat-row { flex-direction: row; margin-top: 12px; }
.stat { flex-grow: 1; flex-basis: 0; height: 64px; margin-right: 12px; padding: 0 18px; font-size: 32px; -unity-text-align: middle-left; border-radius: 10px; background-color: rgba(10, 20, 30, 0.75); }
.info-row { flex-direction: row; justify-content: space-between; margin-top: 14px; margin-right: 12px; }
.mode { font-size: 28px; color: rgb(200, 220, 210); }
.status { height: 104px; margin-top: 14px; font-size: 27px; white-space: normal; color: rgb(250, 206, 120); }
.tool-row { flex-direction: row; margin-top: 4px; }
.tool { flex-grow: 1; flex-basis: 0; height: 64px; margin: 0 12px 0 0; font-size: 26px; }
.controls { position: absolute; bottom: 0; left: 0; right: 0; font-size: 21px; white-space: normal; color: rgb(178, 196, 190); }
.overlay { position: absolute; left: 60%; right: 3%; top: 6%; padding: 26px 30px; background-color: rgba(10, 18, 26, 0.95); border-radius: 14px; border-width: 2px; border-color: rgb(210, 160, 80); }
.headline { font-size: 56px; -unity-font-style: bold; -unity-text-align: middle-center; color: rgb(250, 206, 120); }
.message { margin-top: 10px; margin-bottom: 6px; font-size: 24px; white-space: normal; }
.buttons { align-items: stretch; margin-top: 8px; }
Button { height: 54px; margin: 8px 0 0 0; font-size: 25px; color: rgb(244, 240, 230); background-color: rgb(40, 74, 78); border-color: rgb(120, 170, 160); border-width: 1px; border-radius: 8px; }
Button:hover { background-color: rgb(52, 94, 98); }
Button:active { background-color: rgb(66, 114, 118); }
Button:disabled { color: rgb(150, 160, 158); background-color: rgb(30, 46, 50); }
