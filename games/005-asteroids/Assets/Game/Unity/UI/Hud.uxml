<ui:UXML xmlns:ui="UnityEngine.UIElements">
    <Style src="Hud.uss" />
    <ui:VisualElement name="hud" class="hud" picking-mode="Ignore">
        <ui:Label name="score" text="SCORE  0" class="score" />
        <ui:Label text="A D : TURN   W : THRUST   SPACE : FIRE     P / ESC : PAUSE" class="hint" />
        <ui:Label name="status" class="status" />
        <ui:VisualElement name="overlay" class="overlay">
            <ui:VisualElement class="card">
                <ui:Label name="headline" text="ORBIT BREAKER" class="headline" />
                <ui:Label name="message" class="message" />
                <ui:Button name="submit" text="START" />
                <ui:Button name="resume" text="RESUME" />
                <ui:Button name="back" text="TITLE" />
                <ui:Button name="quit" text="QUIT" />
            </ui:VisualElement>
        </ui:VisualElement>
    </ui:VisualElement>
</ui:UXML>
