.hud { position: absolute; width: 100%; height: 100%; color: rgb(225, 244, 235); }
.score { position: absolute; top: 12px; left: 28px; font-size: 26px; -unity-font-style: bold; }
.hint { position: absolute; right: 28px; top: 16px; font-size: 18px; }
.overlay { position: absolute; width: 100%; height: 100%; align-items: center; justify-content: center; background-color: rgba(4, 12, 20, 0.65); }
.card { width: 620px; padding: 30px; align-items: center; background-color: rgb(14, 30, 40); border-top-left-radius: 18px; border-top-right-radius: 18px; border-bottom-left-radius: 18px; border-bottom-right-radius: 18px; }
.headline { font-size: 56px; -unity-font-style: bold; color: rgb(195, 255, 145); }
.message { font-size: 22px; white-space: normal; -unity-text-align: middle-center; margin-top: 18px; margin-bottom: 24px; }
Button { width: 260px; height: 46px; margin-top: 10px; font-size: 21px; background-color: rgb(32, 63, 69); color: rgb(236, 255, 242); border-color: rgb(77, 126, 117); border-width: 1px; }
Button:hover { background-color: rgb(48, 92, 88); }
Button:active { background-color: rgb(67, 118, 98); }
.status { position: absolute; top: 44%; width: 100%; -unity-text-align: middle-center; font-size: 40px; color: rgb(195, 255, 145); }
