.hud { position: absolute; width: 100%; height: 100%; color: rgb(226, 232, 214); }
.panel { position: absolute; left: 58%; right: 3%; top: 6%; bottom: 6%; padding: 34px; background-color: rgba(16, 22, 34, 0.92); border-radius: 18px; border-width: 1px; border-color: rgb(92, 108, 84); }
.headline { font-size: 60px; -unity-font-style: bold; color: rgb(236, 244, 150); }
.moves { font-size: 32px; -unity-font-style: bold; color: rgb(214, 228, 196); margin-top: 14px; margin-bottom: 14px; padding-top: 12px; padding-bottom: 12px; border-top-width: 1px; border-bottom-width: 1px; border-color: rgb(92, 108, 84); }
.message { flex-grow: 1; font-size: 26px; white-space: normal; }
.buttons { align-items: stretch; }
Button { height: 56px; margin: 7px 0 0 0; font-size: 25px; color: rgb(240, 244, 228); background-color: rgb(52, 70, 62); border-color: rgb(110, 134, 104); border-width: 1px; border-radius: 8px; }
Button:hover { background-color: rgb(66, 88, 76); }
Button:active { background-color: rgb(82, 106, 90); }
