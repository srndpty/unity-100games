<ui:UXML xmlns:ui="UnityEngine.UIElements">
    <Style src="Hud.uss" />
    <ui:VisualElement name="hud" class="hud" picking-mode="Ignore">
        <ui:VisualElement name="panel" class="panel">
            <ui:Label name="headline" text="TIDE CLAIM" class="headline" />
            <ui:VisualElement name="stats" class="stats">
                <ui:Label name="ratio" text=" " class="ratio" />
                <ui:VisualElement name="ratioBar" class="ratio-bar">
                    <ui:VisualElement name="ratioFill" class="ratio-fill" />
                    <ui:VisualElement name="ratioTarget" class="ratio-target" />
                </ui:VisualElement>
                <ui:Label name="lives" text=" " class="stat" />
                <ui:Label name="score" text=" " class="stat" />
            </ui:VisualElement>
            <ui:Label name="message" class="message" />
            <ui:VisualElement class="buttons">
                <ui:Button name="submit" text="はじめる / Enter" />
                <ui:Button name="pause" text="一時停止 / Esc" />
                <ui:Button name="restart" text="新しい試合 / R" />
                <ui:Button name="title" text="タイトルへ / T" />
                <ui:Button name="quit" text="終了" />
            </ui:VisualElement>
        </ui:VisualElement>
    </ui:VisualElement>
</ui:UXML>
