<ui:UXML xmlns:ui="UnityEngine.UIElements">
  <Style src="Hud.uss" />
  <ui:VisualElement name="hud" class="hud" picking-mode="Ignore">
    <ui:VisualElement class="scores" picking-mode="Ignore">
      <ui:Label name="left-score" class="score" text="0" />
      <ui:Label name="right-score" class="score" text="0" />
    </ui:VisualElement>
    <ui:VisualElement name="overlay" class="overlay" picking-mode="Ignore">
      <ui:Label name="headline" class="headline" text="PONG" />
      <ui:Label name="message" class="message" />
    </ui:VisualElement>
  </ui:VisualElement>
</ui:UXML>
