/* 位置と大きさ（left / top / width / height）は BreakoutHud が FieldFraming の結果から割合で決める。ここでは見た目だけ。 */

.hud {
    flex-grow: 1;
    color: rgb(255, 255, 255);
}

/* HUD の領域からはみ出した文字がフィールドに掛からないよう切り取る。 */
.panel {
    position: absolute;
    overflow: hidden;
    padding: 40px 24px 0 24px;
}

.caption {
    font-size: 30px;
    color: rgb(150, 160, 180);
    margin-top: 16px;
}

.value {
    font-size: 64px;
    -unity-font-style: bold;
    color: rgb(255, 255, 255);
}

.effect {
    font-size: 40px;
    -unity-font-style: bold;
    margin-top: 8px;
}

.pierce {
    color: rgb(242, 77, 77);
}

.expand {
    color: rgb(77, 128, 255);
}

.legend {
    font-size: 26px;
    color: rgb(170, 175, 190);
    margin-top: 40px;
    white-space: normal;
}

/* 上部の帯に置くとき（正方形・縦長の画面）は、横に並べて小さくし、凡例はタイトル画面の説明に任せる。 */
.hud--top .panel {
    padding: 16px 24px 0 24px;
}

.hud--top .info {
    flex-direction: row;
    justify-content: space-between;
}

.hud--top .caption {
    font-size: 24px;
    margin-top: 0;
}

.hud--top .value {
    font-size: 48px;
}

.hud--top .effect {
    font-size: 32px;
    margin-top: 4px;
}

.hud--top .legend {
    display: none;
}

.banner {
    position: absolute;
    left: 0;
    right: 0;
    bottom: 28%;
    font-size: 48px;
    -unity-font-style: bold;
    -unity-text-align: middle-center;
    color: rgb(255, 255, 255);
}

.overlay {
    position: absolute;
    left: 0;
    top: 0;
    right: 0;
    bottom: 0;
    align-items: center;
    justify-content: center;
    background-color: rgba(0, 0, 0, 0.75);
}

.headline {
    font-size: 120px;
    -unity-font-style: bold;
    color: rgb(255, 255, 255);
    margin-bottom: 40px;
}

.message {
    font-size: 36px;
    -unity-text-align: middle-center;
    white-space: normal;
    color: rgb(220, 220, 220);
}
