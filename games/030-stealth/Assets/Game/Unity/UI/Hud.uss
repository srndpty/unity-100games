.hud { position: absolute; width: 100%; height: 100%; color: rgb(222, 232, 240); justify-content: center; align-items: center; }
.stats { position: absolute; left: 0; right: 0; top: 0; height: 60px; padding: 0 24px; flex-direction: row; align-items: center; background-color: rgba(10, 16, 24, 0.9); border-bottom-width: 2px; border-color: rgb(70, 110, 140); }
.stat { font-size: 24px; -unity-font-style: bold; margin-right: 34px; -unity-text-outline-width: 1px; -unity-text-outline-color: rgb(6, 10, 14); }
.level { min-width: 90px; padding: 2px 14px; border-radius: 8px; border-width: 1px; border-color: rgb(90, 140, 120); color: rgb(150, 230, 180); -unity-text-align: middle-center; }
.level-caution { color: rgb(255, 220, 120); border-color: rgb(220, 170, 60); background-color: rgba(120, 90, 20, 0.5); }
.level-alert { color: rgb(255, 200, 200); border-color: rgb(240, 80, 70); background-color: rgba(150, 30, 30, 0.7); }
.objective { color: rgb(150, 170, 190); }
.objective.owned { color: rgb(255, 214, 110); }
.debug-toggle { position: absolute; right: 230px; top: 7px; height: 46px; width: 190px; margin: 0; font-size: 20px; }
.pause { position: absolute; right: 20px; top: 7px; height: 46px; width: 196px; margin: 0; font-size: 20px; }
.debug { position: absolute; right: 16px; bottom: 16px; padding: 10px 16px; background-color: rgba(8, 12, 18, 0.82); border-radius: 10px; border-width: 1px; border-color: rgb(80, 120, 150); }
.debug-text { font-size: 19px; white-space: normal; color: rgb(210, 230, 245); }
.toast { position: absolute; top: 76px; padding: 10px 28px; font-size: 24px; -unity-font-style: bold; color: rgb(240, 245, 250); background-color: rgba(10, 16, 24, 0.92); border-radius: 12px; border-width: 2px; border-color: rgb(110, 160, 200); }
.panel { width: 820px; padding: 30px 40px; background-color: rgba(10, 16, 24, 0.95); border-radius: 18px; border-width: 2px; border-color: rgb(80, 130, 170); }
.headline { font-size: 52px; -unity-font-style: bold; color: rgb(150, 210, 255); -unity-text-align: middle-center; white-space: normal; }
.message { margin-top: 14px; margin-bottom: 14px; font-size: 22px; white-space: normal; -unity-text-align: middle-center; }
.buttons { align-items: stretch; }
Button { height: 52px; margin: 8px 0 0 0; font-size: 22px; color: rgb(222, 232, 240); background-color: rgb(30, 52, 72); border-color: rgb(90, 140, 180); border-width: 1px; border-radius: 10px; }
Button:hover { background-color: rgb(40, 66, 90); }
Button:active { background-color: rgb(52, 82, 110); }
