<ui:UXML xmlns:ui="UnityEngine.UIElements">
    <Style src="Hud.uss" />
    <ui:VisualElement name="hud" class="hud" picking-mode="Ignore">
        <ui:VisualElement name="stats" class="stats" picking-mode="Ignore">
            <ui:Label name="level" text=" " class="stat level" />
            <ui:Label name="objective" text=" " class="stat objective" />
            <ui:Label name="time" text=" " class="stat" />
            <ui:Label name="discoveries" text=" " class="stat" />
            <ui:Button name="debug-toggle" text="詳細 OFF / F1" class="debug-toggle" />
            <ui:Button name="pause" text="一時停止 / Esc" class="pause" />
        </ui:VisualElement>
        <ui:VisualElement name="debug" class="debug" picking-mode="Ignore">
            <ui:Label name="debug-text" text=" " class="debug-text" picking-mode="Ignore" />
        </ui:VisualElement>
        <ui:Label name="toast" text=" " class="toast" picking-mode="Ignore" />
        <ui:VisualElement name="panel" class="panel">
            <ui:Label name="headline" text="HUSH WARD" class="headline" />
            <ui:Label name="message" class="message" />
            <ui:VisualElement class="buttons">
                <ui:Button name="submit" text="はじめる / Enter" />
                <ui:Button name="restart" text="最初から / R" />
                <ui:Button name="title" text="タイトルへ / T" />
                <ui:Button name="quit" text="終了" />
            </ui:VisualElement>
        </ui:VisualElement>
    </ui:VisualElement>
</ui:UXML>
