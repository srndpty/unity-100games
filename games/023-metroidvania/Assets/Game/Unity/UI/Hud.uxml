<ui:UXML xmlns:ui="UnityEngine.UIElements">
    <Style src="Hud.uss" />
    <ui:VisualElement name="hud" class="hud" picking-mode="Ignore">
        <ui:VisualElement name="stats" class="stats" picking-mode="Ignore">
            <ui:Label name="room" text=" " class="stat room" />
            <ui:Label name="health" text=" " class="stat health" />
            <ui:Label name="ability-jump" text="二段ジャンプ" class="stat ability" />
            <ui:Label name="ability-break" text="破壊ショット" class="stat ability" />
            <ui:Label name="time" text=" " class="stat" />
            <ui:Label name="deaths" text=" " class="stat" />
            <ui:VisualElement name="minimap" class="map minimap" picking-mode="Ignore" />
            <ui:Button name="pause" text="地図 / Esc" class="pause" />
        </ui:VisualElement>
        <ui:Label name="toast" text=" " class="toast" picking-mode="Ignore" />
        <ui:VisualElement name="panel" class="panel">
            <ui:Label name="headline" text="MOSSLIGHT DEPTHS" class="headline" />
            <ui:VisualElement name="bigmap" class="map bigmap" picking-mode="Ignore" />
            <ui:Label name="message" class="message" />
            <ui:VisualElement class="buttons">
                <ui:Button name="submit" text="はじめる / Enter" />
                <ui:Button name="restart" text="最初から / R" />
                <ui:Button name="title" text="タイトルへ / T" />
                <ui:Button name="quit" text="終了" />
            </ui:VisualElement>
        </ui:VisualElement>
    </ui:VisualElement>
</ui:UXML>
