<ui:UXML xmlns:ui="UnityEngine.UIElements">
    <Style src="Hud.uss" />
    <ui:VisualElement name="hud" class="hud" picking-mode="Ignore">
        <ui:VisualElement name="topbar" class="topbar" picking-mode="Ignore">
            <ui:VisualElement name="scoreboard" class="scoreboard" picking-mode="Ignore">
                <ui:Label name="format" text=" " class="format" />
                <ui:VisualElement class="row" picking-mode="Ignore">
                    <ui:Label text="YOU" class="name near-name" />
                    <ui:Label name="near-serve" text=" " class="serve" />
                    <ui:Label name="near-games" text="0" class="games" />
                    <ui:Label name="near-points" text="0" class="points" />
                </ui:VisualElement>
                <ui:VisualElement class="row" picking-mode="Ignore">
                    <ui:Label text="CPU" class="name far-name" />
                    <ui:Label name="far-serve" text=" " class="serve" />
                    <ui:Label name="far-games" text="0" class="games" />
                    <ui:Label name="far-points" text="0" class="points" />
                </ui:VisualElement>
            </ui:VisualElement>
            <ui:Button name="pause" text="一時停止 / Esc" class="pause" />
        </ui:VisualElement>
        <ui:Label name="verdict" text=" " class="verdict" picking-mode="Ignore" />
        <ui:Label name="guide" text=" " class="guide" picking-mode="Ignore" />
        <ui:VisualElement name="panel" class="panel">
            <ui:Label name="headline" text="BASELINE BLOOM" class="headline" />
            <ui:Label name="message" class="message" />
            <ui:VisualElement class="buttons">
                <ui:Button name="submit" text="はじめる / Enter" />
                <ui:Button name="restart" text="最初から / R" />
                <ui:Button name="title" text="タイトルへ / T" />
                <ui:Button name="quit" text="終了" />
            </ui:VisualElement>
        </ui:VisualElement>
    </ui:VisualElement>
</ui:UXML>
