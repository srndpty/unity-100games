.hud { position: absolute; width: 100%; height: 100%; color: rgb(255, 236, 214); justify-content: center; align-items: center; }
.side { position: absolute; left: 52%; right: 3%; top: 6%; padding: 24px 32px; background-color: rgba(20, 10, 18, 0.78); border-radius: 14px; border-width: 2px; border-color: rgb(190, 110, 60); }
.stat { font-size: 30px; margin-bottom: 14px; -unity-text-outline-width: 1px; -unity-text-outline-color: rgb(10, 4, 8); white-space: normal; }
.score { color: rgb(255, 226, 120); font-size: 38px; -unity-font-style: bold; }
.lives { color: rgb(255, 150, 140); letter-spacing: 3px; }
.bombs { color: rgb(160, 220, 255); letter-spacing: 3px; }
.boss { color: rgb(255, 190, 120); margin-top: 18px; -unity-font-style: bold; }
.pattern { color: rgb(255, 236, 214); }
.time { color: rgb(200, 240, 200); }
.bullets { color: rgb(200, 180, 230); font-size: 24px; }
.pause { height: 52px; margin: 18px 0 0 0; font-size: 24px; }
.panel { width: 900px; padding: 30px 40px; background-color: rgba(24, 10, 18, 0.95); border-radius: 18px; border-width: 2px; border-color: rgb(220, 130, 70); }
.headline { font-size: 60px; -unity-font-style: bold; color: rgb(255, 196, 110); -unity-text-align: middle-center; white-space: normal; }
.message { margin-top: 14px; margin-bottom: 14px; font-size: 24px; white-space: normal; -unity-text-align: middle-center; }
.buttons { align-items: stretch; }
Button { height: 52px; margin: 8px 0 0 0; font-size: 22px; color: rgb(255, 236, 214); background-color: rgb(90, 38, 30); border-color: rgb(220, 130, 70); border-width: 1px; border-radius: 10px; }
Button:hover { background-color: rgb(116, 50, 38); }
Button:active { background-color: rgb(140, 62, 46); }
