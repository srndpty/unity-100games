<ui:UXML xmlns:ui="UnityEngine.UIElements">
    <Style src="Hud.uss" />
    <ui:VisualElement name="hud" class="hud" picking-mode="Ignore">
        <ui:VisualElement name="bar" class="bar" picking-mode="Ignore">
            <ui:Label name="stage" text=" " class="stat stage" />
            <ui:Label name="shots" text=" " class="stat shots" />
            <ui:Label name="targets" text=" " class="stat targets" />
            <ui:Label name="score" text=" " class="stat score" />
            <ui:Label name="best" text=" " class="stat best" />
        </ui:VisualElement>
        <ui:Label name="hint" text=" " class="hint" picking-mode="Ignore" />
        <ui:VisualElement name="panel" class="panel" picking-mode="Ignore">
            <ui:Label name="headline" text="PEBBLE SIEGE" class="headline" />
            <ui:Label name="message" text=" " class="message" />
            <ui:VisualElement name="tiles" class="tiles" picking-mode="Ignore" />
        </ui:VisualElement>
    </ui:VisualElement>
</ui:UXML>
