.hud { position: absolute; width: 100%; height: 100%; color: rgb(246, 238, 224); justify-content: center; align-items: center; }
.bar { position: absolute; left: 0; right: 0; top: 0; height: 64px; padding: 0 28px; flex-direction: row; align-items: center; background-color: rgba(34, 24, 20, 0.88); border-bottom-width: 2px; border-color: rgb(200, 140, 90); }
.stat { font-size: 26px; -unity-font-style: bold; margin-right: 40px; -unity-text-outline-width: 1px; -unity-text-outline-color: rgb(12, 8, 6); }
.stage { color: rgb(255, 214, 160); }
.shots { color: rgb(230, 230, 236); }
.targets { color: rgb(255, 150, 130); }
.score { color: rgb(255, 226, 140); }
.best { position: absolute; right: 28px; margin-right: 0; color: rgb(170, 220, 255); }
.hint { position: absolute; top: 72px; padding: 6px 20px; font-size: 22px; color: rgb(246, 238, 224); background-color: rgba(34, 24, 20, 0.72); border-radius: 10px; }
.panel { width: 1120px; padding: 30px 44px; background-color: rgba(30, 22, 18, 0.95); border-radius: 18px; border-width: 2px; border-color: rgb(210, 150, 100); }
.panel.outcome { position: absolute; top: 84px; width: 980px; padding: 18px 36px; background-color: rgba(30, 22, 18, 0.88); }
.headline { font-size: 58px; -unity-font-style: bold; color: rgb(255, 210, 150); -unity-text-align: middle-center; white-space: normal; }
.outcome .headline { font-size: 44px; }
.message { margin-top: 14px; font-size: 24px; white-space: normal; -unity-text-align: middle-center; }
.tiles { margin-top: 22px; flex-direction: row; flex-wrap: wrap; justify-content: center; }
.tile { width: 190px; height: 112px; margin: 8px; padding: 6px; align-items: center; justify-content: center; background-color: rgb(58, 42, 34); border-width: 2px; border-color: rgb(120, 90, 70); border-radius: 12px; color: rgb(246, 238, 224); }
.tile:hover { background-color: rgb(76, 56, 44); }
.tile:disabled { opacity: 0.45; }
.tile.selected { border-width: 4px; border-color: rgb(255, 214, 110); }
.tile.solved { background-color: rgb(70, 60, 36); }
#tile-number { font-size: 30px; -unity-font-style: bold; }
#tile-name { font-size: 20px; }
#tile-best { font-size: 17px; color: rgb(255, 214, 110); }
