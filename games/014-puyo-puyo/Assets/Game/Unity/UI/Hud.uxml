<ui:UXML xmlns:ui="UnityEngine.UIElements">
    <Style src="Hud.uss" />
    <ui:VisualElement name="hud" class="hud" picking-mode="Ignore">
        <ui:Label text="あなた" class="field-title field-title--player" />
        <ui:Label text="CPU" class="field-title field-title--cpu" />
        <ui:VisualElement name="stats" class="stats" picking-mode="Ignore">
            <ui:VisualElement class="column column--player" picking-mode="Ignore">
                <ui:Label text="次" class="column-title" />
                <ui:VisualElement class="next-space" picking-mode="Ignore" />
                <ui:Label text="スコア" class="stat-name" />
                <ui:Label name="player-score" text="0" class="stat-value" />
                <ui:Label name="player-pending" class="pending" />
                <ui:Label name="player-chain" class="chain" />
            </ui:VisualElement>
            <ui:VisualElement class="column column--cpu" picking-mode="Ignore">
                <ui:Label text="次" class="column-title" />
                <ui:VisualElement class="next-space" picking-mode="Ignore" />
                <ui:Label text="スコア" class="stat-name" />
                <ui:Label name="cpu-score" text="0" class="stat-value" />
                <ui:Label name="cpu-pending" class="pending" />
                <ui:Label name="cpu-chain" class="chain" />
            </ui:VisualElement>
        </ui:VisualElement>
        <ui:Label name="controls" class="controls" picking-mode="Ignore" />
        <ui:VisualElement name="overlay" class="overlay">
            <ui:Label name="headline" text="SPORE BLOOM" class="headline" />
            <ui:Label name="message" class="message" />
            <ui:VisualElement class="buttons">
                <ui:Button name="submit" text="はじめる  /  Enter" />
                <ui:Button name="restart" text="やり直す  /  R" />
                <ui:Button name="title" text="タイトルへ  /  T" />
                <ui:Button name="quit" text="終了" />
            </ui:VisualElement>
        </ui:VisualElement>
    </ui:VisualElement>
</ui:UXML>
