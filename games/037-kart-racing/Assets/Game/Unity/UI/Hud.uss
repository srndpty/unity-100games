.hud {
    position: absolute;
    left: 0;
    top: 0;
    right: 0;
    bottom: 0;
    color: rgb(245, 245, 240);
    -unity-font-style: bold;
}

.layer {
    position: absolute;
    left: 0;
    top: 0;
    right: 0;
    bottom: 0;
}

.hidden {
    display: none;
}

/* ---- レース中 ---- */

.place-card {
    position: absolute;
    left: 36px;
    top: 28px;
    padding: 10px 26px 14px 22px;
    background-color: rgba(10, 12, 16, 0.62);
    border-radius: 14px;
}

.place-row {
    flex-direction: row;
    align-items: flex-end;
}

.place {
    font-size: 108px;
    margin: 0;
    padding: 0;
    -unity-text-outline-width: 1px;
    -unity-text-outline-color: rgba(0, 0, 0, 0.6);
}

.place-suffix {
    font-size: 44px;
    margin: 0 0 18px 2px;
    padding: 0;
}

.place-of {
    font-size: 34px;
    margin: 0 0 20px 14px;
    padding: 0;
    color: rgb(170, 176, 186);
}

.lap {
    font-size: 36px;
    margin: -6px 0 0 4px;
    padding: 0;
    letter-spacing: 4px;
}

.order {
    position: absolute;
    left: 36px;
    top: 250px;
    width: 250px;
    padding: 10px 14px;
    background-color: rgba(10, 12, 16, 0.5);
    border-radius: 12px;
}

.order-row {
    flex-direction: row;
    align-items: center;
    height: 40px;
}

.order-place {
    width: 34px;
    font-size: 28px;
    margin: 0;
    padding: 0;
    color: rgb(190, 196, 204);
}

.order-chip {
    width: 18px;
    height: 18px;
    border-radius: 9px;
    margin: 0 12px 0 4px;
    border-width: 2px;
    border-color: rgba(255, 255, 255, 0.85);
}

.order-name {
    font-size: 28px;
    margin: 0;
    padding: 0;
}

.order-you {
    color: rgb(255, 214, 64);
}

.minimap-card {
    position: absolute;
    right: 36px;
    top: 28px;
    width: 500px;
    height: 190px;
    background-color: rgba(10, 12, 16, 0.6);
    border-radius: 14px;
}

.minimap {
    position: absolute;
    left: 0;
    top: 0;
    right: 0;
    bottom: 0;
}

.speed-card {
    position: absolute;
    left: 36px;
    bottom: 32px;
    flex-direction: row;
    align-items: flex-end;
    padding: 4px 24px 10px 22px;
    background-color: rgba(10, 12, 16, 0.6);
    border-radius: 14px;
}

.speed {
    font-size: 84px;
    margin: 0;
    padding: 0;
    min-width: 150px;
    -unity-text-align: lower-right;
}

.speed-unit {
    font-size: 30px;
    margin: 0 0 16px 10px;
    padding: 0;
    color: rgb(190, 196, 204);
}

.charge {
    position: absolute;
    left: 0;
    right: 0;
    bottom: 48px;
    font-size: 46px;
    -unity-text-align: middle-center;
    letter-spacing: 6px;
    -unity-text-outline-width: 2px;
    -unity-text-outline-color: rgba(0, 0, 0, 0.75);
}

.charge-drift {
    color: rgb(120, 200, 255);
}

.charge-ready {
    color: rgb(255, 150, 60);
}

.charge-boost {
    color: rgb(255, 230, 90);
}

.countdown {
    position: absolute;
    left: 0;
    right: 0;
    top: 150px;
    font-size: 150px;
    -unity-text-align: middle-center;
    color: rgb(255, 255, 255);
    -unity-text-outline-width: 4px;
    -unity-text-outline-color: rgba(0, 0, 0, 0.7);
}

.countdown-go {
    color: rgb(120, 230, 120);
}

/* ---- タイトル ---- */

.title-screen {
    flex-direction: row;
}

.title-card {
    width: 820px;
    height: 100%;
    padding: 110px 70px 80px 96px;
    background-color: rgba(8, 10, 14, 0.8);
    border-right-width: 6px;
    border-right-color: rgb(255, 196, 40);
}

.title-word {
    font-size: 132px;
    margin: 0;
    padding: 0;
    letter-spacing: 14px;
    -unity-text-outline-width: 1px;
    -unity-text-outline-color: rgba(0, 0, 0, 0.5);
}

.title-accent {
    color: rgb(255, 196, 40);
    margin-top: -26px;
}

.title-sub {
    font-size: 30px;
    margin: 10px 0 0 6px;
    padding: 0;
    letter-spacing: 6px;
    color: rgb(180, 188, 200);
}

.divider {
    height: 4px;
    width: 140px;
    margin: 40px 0 34px 6px;
    background-color: rgb(220, 60, 50);
}

.controls {
    margin-left: 6px;
}

.control-row {
    flex-direction: row;
    align-items: center;
    height: 58px;
}

.key {
    min-width: 200px;
    font-size: 28px;
    margin: 0 26px 0 0;
    padding: 6px 14px;
    -unity-text-align: middle-center;
    background-color: rgba(255, 255, 255, 0.1);
    border-width: 2px;
    border-color: rgba(255, 255, 255, 0.35);
    border-radius: 8px;
}

.control-text {
    font-size: 30px;
    margin: 0;
    padding: 0;
    color: rgb(225, 228, 232);
}

.title-note {
    font-size: 26px;
    margin: 30px 0 0 6px;
    padding: 0;
    white-space: normal;
    color: rgb(170, 178, 190);
    -unity-font-style: normal;
}

.title-start {
    position: absolute;
    left: 96px;
    bottom: 86px;
    font-size: 52px;
    margin: 0;
    padding: 12px 34px;
    color: rgb(20, 20, 24);
    background-color: rgb(255, 196, 40);
    border-radius: 10px;
}

/* ---- 一時停止・結果 ---- */

.overlay {
    align-items: center;
    justify-content: center;
    background-color: rgba(6, 8, 12, 0.55);
}

.card {
    padding: 40px 70px 44px 70px;
    background-color: rgba(14, 16, 22, 0.92);
    border-radius: 18px;
    border-width: 3px;
    border-color: rgba(255, 255, 255, 0.18);
    align-items: center;
}

.card-title {
    font-size: 72px;
    margin: 0 0 20px 0;
    padding: 0;
}

.card-line {
    font-size: 34px;
    margin: 6px 0;
    padding: 0;
    color: rgb(215, 220, 228);
}

.card-hint {
    font-size: 30px;
    margin: 30px 0 0 0;
    padding: 0;
    color: rgb(190, 196, 204);
}

.result-card {
    width: 980px;
}

.result-title {
    font-size: 120px;
    margin: 0;
    padding: 0;
    letter-spacing: 16px;
}

.result-win {
    color: rgb(255, 205, 50);
}

.result-lose {
    color: rgb(170, 190, 220);
}

.result-sub {
    font-size: 34px;
    margin: 0 0 26px 0;
    padding: 0;
    color: rgb(205, 210, 218);
}

.result-rows {
    width: 100%;
}

.result-row {
    flex-direction: row;
    align-items: center;
    height: 70px;
    padding: 0 26px;
    margin: 4px 0;
    border-radius: 10px;
    background-color: rgba(255, 255, 255, 0.05);
}

.result-row-you {
    background-color: rgba(255, 205, 50, 0.18);
}

.result-place {
    width: 90px;
    font-size: 44px;
    margin: 0;
    padding: 0;
}

.result-chip {
    width: 24px;
    height: 24px;
    border-radius: 12px;
    margin: 0 22px 0 0;
    border-width: 2px;
    border-color: rgba(255, 255, 255, 0.85);
}

.result-name {
    flex-grow: 1;
    font-size: 38px;
    margin: 0;
    padding: 0;
}

.result-time {
    font-size: 36px;
    margin: 0;
    padding: 0;
    -unity-text-align: middle-right;
    color: rgb(225, 228, 232);
}
