.hud { position: absolute; width: 100%; height: 100%; color: rgb(232, 226, 214); }
.column { position: absolute; top: 7%; width: 14.7%; }
.column--left { left: 19.4%; }
.column--right { left: 65.9%; }
.column-title { font-size: 30px; -unity-font-style: bold; -unity-text-align: middle-center; color: rgb(236, 190, 104); }
.hold-space { height: 290px; }
.stats { padding-top: 6px; }
.stat-name { font-size: 22px; color: rgb(190, 180, 164); }
.stat-value { font-size: 36px; -unity-font-style: bold; margin-bottom: 6px; color: rgb(246, 240, 228); }
.controls { position: absolute; left: 2%; top: 7%; width: 16.5%; font-size: 21px; white-space: normal; color: rgb(204, 196, 182); }
.overlay { position: absolute; left: 31%; right: 31%; top: 14%; padding: 30px; background-color: rgb(30, 25, 22); border-radius: 14px; border-width: 2px; border-color: rgb(150, 112, 66); }
.headline { font-size: 54px; -unity-font-style: bold; -unity-text-align: middle-center; color: rgb(236, 190, 104); }
.message { margin-top: 14px; margin-bottom: 10px; font-size: 25px; white-space: normal; }
.buttons { align-items: stretch; }
Button { height: 58px; margin: 8px 0 0 0; font-size: 26px; color: rgb(246, 240, 228); background-color: rgb(96, 66, 40); border-color: rgb(168, 126, 76); border-width: 1px; border-radius: 8px; }
Button:hover { background-color: rgb(118, 82, 50); }
Button:active { background-color: rgb(140, 98, 60); }
