.hud { position: absolute; width: 100%; height: 100%; color: rgb(236, 240, 255); justify-content: center; align-items: center; }
.stats { position: absolute; left: 0; right: 0; top: 0; height: 60px; padding: 0 28px; flex-direction: row; align-items: center; background-color: rgba(16, 18, 40, 0.78); border-bottom-width: 2px; border-color: rgb(110, 120, 200); }
.stat { font-size: 25px; -unity-font-style: bold; margin-right: 44px; -unity-text-outline-width: 1px; -unity-text-outline-color: rgb(10, 10, 24); }
.room { color: rgb(255, 220, 140); }
.dash { color: rgb(150, 210, 255); }
.pause { position: absolute; right: 20px; top: 7px; height: 46px; width: 200px; margin: 0; font-size: 20px; }
.panel { width: 680px; padding: 32px 40px; background-color: rgba(20, 22, 48, 0.93); border-radius: 18px; border-width: 2px; border-color: rgb(120, 130, 210); }
.headline { font-size: 54px; -unity-font-style: bold; color: rgb(255, 220, 140); -unity-text-align: middle-center; white-space: normal; }
.message { margin-top: 16px; margin-bottom: 16px; font-size: 23px; white-space: normal; -unity-text-align: middle-center; }
.buttons { align-items: stretch; }
Button { height: 54px; margin: 8px 0 0 0; font-size: 23px; color: rgb(236, 240, 255); background-color: rgb(58, 64, 120); border-color: rgb(130, 140, 220); border-width: 1px; border-radius: 10px; }
Button:hover { background-color: rgb(72, 80, 140); }
Button:active { background-color: rgb(88, 96, 160); }
