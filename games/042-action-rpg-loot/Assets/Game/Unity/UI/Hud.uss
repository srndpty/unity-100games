.hud { position: absolute; width: 100%; height: 100%; color: rgb(236, 226, 210); justify-content: center; align-items: center; }
.tags { position: absolute; left: 0; top: 0; width: 100%; height: 100%; }
.tag { position: absolute; height: 26px; margin: 0; padding: 0 8px; font-size: 16px; border-width: 1px; border-radius: 4px; background-color: rgba(12, 8, 6, 0.82); border-color: rgba(120, 100, 80, 0.9); translate: -50% -100%; }
.tag:hover { background-color: rgba(60, 44, 30, 0.95); }
.stats { position: absolute; left: 0; right: 0; top: 0; height: 60px; padding: 0 24px; flex-direction: row; align-items: center; background-color: rgba(14, 10, 8, 0.78); border-bottom-width: 2px; border-color: rgb(120, 80, 50); }
.life-bar { width: 300px; height: 30px; margin-right: 28px; background-color: rgb(40, 14, 14); border-width: 2px; border-color: rgb(150, 60, 50); border-radius: 6px; overflow: hidden; justify-content: center; }
.life-fill { position: absolute; left: 0; top: 0; bottom: 0; width: 100%; background-color: rgb(190, 40, 40); }
.life-text { -unity-text-align: middle-center; font-size: 20px; -unity-font-style: bold; -unity-text-outline-width: 1px; -unity-text-outline-color: rgb(20, 4, 4); }
.stat { font-size: 22px; -unity-font-style: bold; margin-right: 32px; -unity-text-outline-width: 1px; -unity-text-outline-color: rgb(14, 8, 4); }
.potions { color: rgb(255, 140, 140); min-width: 110px; }
.skill { color: rgb(170, 220, 255); min-width: 230px; }
.floor { color: rgb(240, 200, 120); }
.boss { position: absolute; top: 72px; width: 640px; align-items: center; }
.boss-name { font-size: 22px; -unity-font-style: bold; color: rgb(255, 170, 90); -unity-text-outline-width: 1px; -unity-text-outline-color: rgb(20, 8, 4); }
.boss-bar { width: 100%; height: 16px; background-color: rgb(40, 16, 8); border-width: 2px; border-color: rgb(200, 110, 50); border-radius: 4px; overflow: hidden; }
.boss-fill { position: absolute; left: 0; top: 0; bottom: 0; width: 100%; background-color: rgb(230, 110, 40); }
.toast { position: absolute; bottom: 80px; font-size: 24px; -unity-font-style: bold; color: rgb(255, 236, 180); -unity-text-outline-width: 1px; -unity-text-outline-color: rgb(20, 10, 4); }
.hint { position: absolute; bottom: 14px; font-size: 18px; color: rgba(236, 226, 210, 0.85); background-color: rgba(14, 10, 8, 0.6); padding: 4px 14px; border-radius: 6px; }
.panel { width: 900px; padding: 30px 40px; background-color: rgba(18, 12, 10, 0.95); border-radius: 18px; border-width: 2px; border-color: rgb(160, 100, 60); }
.headline { font-size: 56px; -unity-font-style: bold; color: rgb(255, 190, 110); -unity-text-align: middle-center; white-space: normal; }
.message { margin-top: 14px; margin-bottom: 14px; font-size: 21px; white-space: normal; -unity-text-align: middle-center; }
.buttons { align-items: stretch; }
Button { height: 48px; margin: 6px 0 0 0; font-size: 20px; color: rgb(240, 228, 210); background-color: rgb(70, 40, 26); border-color: rgb(170, 110, 70); border-width: 1px; border-radius: 8px; }
Button:hover { background-color: rgb(92, 54, 34); }
Button:active { background-color: rgb(118, 70, 44); }
.inventory { position: absolute; left: 60px; right: 60px; top: 90px; bottom: 70px; padding: 20px; flex-direction: row; background-color: rgba(18, 12, 10, 0.96); border-radius: 14px; border-width: 2px; border-color: rgb(160, 100, 60); }
.inv-column { padding: 0 14px; }
.inv-left { width: 26%; }
.inv-middle { width: 38%; }
.inv-right { width: 36%; }
.inv-title { font-size: 22px; -unity-font-style: bold; color: rgb(240, 200, 120); margin: 4px 0 6px 0; }
.equip { margin-bottom: 10px; }
.slot { height: 40px; -unity-text-align: middle-left; font-size: 17px; padding-left: 10px; margin-top: 4px; }
.bag { flex-direction: row; flex-wrap: wrap; }
.cell { width: 48%; height: 40px; margin: 4px 1% 0 1%; -unity-text-align: middle-left; font-size: 15px; padding-left: 8px; overflow: hidden; }
.selected { border-width: 3px; border-color: rgb(255, 230, 140); background-color: rgb(96, 62, 36); }
.empty { color: rgba(236, 226, 210, 0.35); }
.sheet { font-size: 17px; white-space: normal; }
.detail-name { font-size: 24px; -unity-font-style: bold; white-space: normal; margin-bottom: 6px; }
.detail { font-size: 18px; white-space: normal; margin-bottom: 10px; }
.compare { font-size: 18px; white-space: normal; color: rgb(170, 230, 170); margin-bottom: 10px; }
.inv-actions { flex-direction: row; flex-wrap: wrap; }
.inv-actions Button { width: 48%; margin: 4px 1% 0 1%; }
.inv-note { font-size: 18px; color: rgb(255, 180, 140); margin-top: 8px; }
