<ui:UXML xmlns:ui="UnityEngine.UIElements">
    <Style src="Hud.uss" />
    <ui:VisualElement name="hud" class="hud" picking-mode="Ignore">
        <ui:VisualElement name="stats" class="stats" picking-mode="Ignore">
            <ui:Label text="スコア" class="stat-name" />
            <ui:Label name="score" text="0" class="score" />
            <ui:VisualElement class="progress" picking-mode="Ignore">
                <ui:VisualElement name="progress-fill" class="progress-fill" picking-mode="Ignore" />
            </ui:VisualElement>
            <ui:Label name="target" class="target" />
            <ui:Label text="のこり手数" class="stat-name stat-name--moves" />
            <ui:Label name="moves" text="0" class="moves" />
            <ui:Label name="chain" class="chain" />
            <ui:Label name="controls" class="controls" picking-mode="Ignore" />
        </ui:VisualElement>
        <ui:VisualElement name="overlay" class="overlay">
            <ui:Label name="headline" text="PRISM TIDE" class="headline" />
            <ui:Label name="message" class="message" />
            <ui:VisualElement class="buttons">
                <ui:Button name="submit" text="はじめる  /  Enter" />
                <ui:Button name="restart" text="やり直す  /  R" />
                <ui:Button name="title" text="タイトルへ  /  T" />
                <ui:Button name="quit" text="終了" />
            </ui:VisualElement>
        </ui:VisualElement>
    </ui:VisualElement>
</ui:UXML>
