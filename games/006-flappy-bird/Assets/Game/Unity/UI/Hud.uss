.hud { position: absolute; width: 100%; height: 100%; color: rgb(230, 247, 245); }
.score { position: absolute; top: 14px; left: 28px; font-size: 26px; -unity-font-style: bold; }
.hint { position: absolute; right: 28px; top: 18px; font-size: 18px; color: rgb(164, 201, 207); }
.overlay { position: absolute; width: 100%; height: 100%; align-items: center; justify-content: center; background-color: rgba(4, 16, 25, 0.68); }
.card { width: 610px; padding: 30px; align-items: center; background-color: rgb(14, 39, 51); border-radius: 18px; border-width: 1px; border-color: rgb(56, 98, 112); }
.eyebrow { font-size: 16px; letter-spacing: 3px; color: rgb(119, 200, 191); }
.headline { font-size: 60px; -unity-font-style: bold; color: rgb(255, 218, 120); margin-top: 10px; }
.message { font-size: 22px; white-space: normal; -unity-text-align: middle-center; margin-top: 16px; margin-bottom: 20px; }
Button { width: 260px; height: 46px; margin-top: 10px; font-size: 21px; background-color: rgb(29, 80, 86); color: rgb(236, 255, 242); border-color: rgb(80, 148, 144); border-width: 1px; border-radius: 7px; }
Button:hover { background-color: rgb(44, 110, 112); }
Button:active { background-color: rgb(64, 135, 129); }
.status { position: absolute; top: 25%; width: 100%; -unity-text-align: middle-center; white-space: normal; font-size: 30px; color: rgb(255, 225, 155); }
