.hud { position: absolute; width: 100%; height: 100%; color: rgb(244, 234, 208); }
.bar { position: absolute; top: 0; left: 3%; right: 3%; height: 10%; flex-direction: row; align-items: center; }
.stat { font-size: 34px; -unity-font-style: bold; margin-right: 56px; color: rgb(247, 214, 140); }
.status { font-size: 30px; margin-left: auto; color: rgb(214, 200, 176); }
.overlay { position: absolute; width: 100%; height: 100%; align-items: center; justify-content: center; background-color: rgba(14, 10, 9, 0.68); }
.card { width: 860px; padding: 32px; align-items: center; background-color: rgb(44, 32, 27); border-radius: 20px; border-width: 1px; border-color: rgb(146, 112, 78); }
.headline { font-size: 60px; -unity-font-style: bold; color: rgb(248, 219, 151); }
.message { font-size: 25px; white-space: normal; -unity-text-align: middle-center; margin-top: 14px; margin-bottom: 14px; }
Button { width: 300px; height: 50px; margin-top: 10px; font-size: 23px; color: rgb(247, 238, 214); background-color: rgb(116, 78, 48); border-color: rgb(170, 128, 86); border-width: 1px; border-radius: 8px; }
Button:hover { background-color: rgb(140, 96, 58); }
Button:active { background-color: rgb(160, 112, 68); }
