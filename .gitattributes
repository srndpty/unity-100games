* text=auto eol=lf
*.cmd text eol=crlf
# 進捗台帳は Excel で開けるよう CRLF のまま保つ
*.csv text eol=crlf

# Unity のテキストシリアライズ資産
*.meta text eol=lf
*.unity text eol=lf
*.prefab text eol=lf
*.asset text eol=lf
*.mat text eol=lf
*.anim text eol=lf
*.controller text eol=lf

# バイナリ
*.png binary
*.jpg binary
*.psd binary
*.wav binary
*.mp3 binary
*.ogg binary
*.ttf binary
*.otf binary
*.fbx binary

# 外部の素材（ユニティちゃんなど）の大きいバイナリは Git LFS で持つ（pre-commit の check-added-large-files は LFS のファイルを検査しない）
games/*/Assets/UnityChan/**/*.tga filter=lfs diff=lfs merge=lfs -text
games/*/Assets/UnityChan/**/*.fbx filter=lfs diff=lfs merge=lfs -text
games/*/Assets/UnityChan/**/*.pdf filter=lfs diff=lfs merge=lfs -text
games/*/Assets/UnityChan/**/*.psd filter=lfs diff=lfs merge=lfs -text
games/*/Assets/UnityChan/**/*.ai filter=lfs diff=lfs merge=lfs -text
games/*/Assets/UnityChan/**/*.jpg filter=lfs diff=lfs merge=lfs -text
games/*/Assets/UnityChan/**/*.png filter=lfs diff=lfs merge=lfs -text
games/*/Assets/UnityChan/**/*.svg filter=lfs diff=lfs merge=lfs -text
